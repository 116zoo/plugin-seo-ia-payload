{
  "name": "@scope/payload-plugin-nim-seo",
  "version": "0.0.1",
  "description": "Reviewable, locale-specific SEO proposals for Payload CMS v3 with NVIDIA NIM.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "types": "./dist/exports/rsc.d.ts",
      "import": "./dist/exports/rsc.js",
      "default": "./dist/exports/rsc.js"
    },
    "./helpers": {
      "types": "./dist/helpers/metadata.d.ts",
      "import": "./dist/helpers/metadata.js",
      "default": "./dist/helpers/metadata.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:check": "tsx dev/check-startup.ts"
  },
  "peerDependencies": {
    "payload": "^3.93.0",
    "@payloadcms/ui": "^3.93.0",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1 || ^19.3.0",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1 || ^19.3.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "graphql": "^16.8.1",
    "next": "^16.4.6",
    "payload": "3.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
